{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "description": "Writing Tools Desktop Application",
  "author": "Writing Tools Team",
  "license": "MIT",
  "main": "dist/main.js",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-scripts": "5.0.1",
    "rimraf": "^6.1.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "build": "concurrently \"npm run render:build\" \"npm run electron:build\"",
    "eject": "react-scripts eject",
    "electron-dev": "concurrently \"npm run render:start\" \"npm run electron:start\"",
    "electron-dev:watch": "concurrently \"npm run render:start\" \"tsc -p tsconfig.main.json --watch\" \"nodemon --watch dist/main.js --exec 'npm run electron:start'\"",
    "electron:build": "tsc -p tsconfig.main.json && electron-builder",
    "electron:start": "electron .",
    "prebuild": "rimraf dist",
    "render:build": "react-scripts build",
    "render:start": "react-scripts start --watch",
    "render:test": "react-scripts test",
    "test:electron": "node test-electron.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "chokidar": "^3.6.0",
    "concurrently": "^9.2.1",
    "electron": "^39.0.0",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^3.0.1",
    "nodemon": "^3.1.10"
  }
}
