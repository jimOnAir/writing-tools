{
  "private": true,
  "version": "1.0.0",
  "name": "writing-tools",
  "description": "Writing Tools Desktop Application",
  "author": "Writing Tools Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "main/main.js",
  "scripts": {
    "build": "npm run build:shared && npm run build:main && npm run build:render",
    "build:main": "npm run build:esbuild -w @writing-tools/main",
    "build:render": "npm run build -w @writing-tools/renderer",
    "build:shared": "npm run build -w @writing-tools/shared",
    "prestart": "npm run build:shared",
    "start": "concurrently 'npm run start:render' 'npm run start:main'",
    "prestart:main": "npm run build:main",
    "start:main": "npm run start -w @writing-tools/main",
    "start:render": "npm run start -w @writing-tools/renderer",
    "lint": "npm run lint -w @writing-tools/main; npm run lint -w @writing-tools/renderer; npm run lint -w @writing-tools/shared",
    "clean": "rimraf node_modules packages/*/node_modules",
    "build:electron": "electron-builder -- publish=never",
    "prebuild:electron": "rimraf release && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-eslint-plugin": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "rimraf": "^6.1.2",
    "typescript": "^4.9.5",
    "typescript-eslint": "^8.51.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
