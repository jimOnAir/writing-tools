{
  "name": "@writing-tools/main",
  "version": "0.1.0",
  "private": true,
  "description": "Writing Tools Desktop Application",
  "author": "Writing Tools Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/electron-app/main.js",
  "scripts": {
    "build:esbuild": "node scripts/build-esbuild.js",
    "build": "tsc -b",
    "prebuild:esbuild": "rimraf dist",
    "prebuild": "rimraf dist",
    "prestart": "npx electron-rebuild -f -w better-sqlite3-multiple-ciphers && npm run build:esbuild",
    "start": "electron .",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "lint:check": "eslint src --ext .ts,.tsx",
    "build:electron": "electron-builder -- publish=never",
    "prebuild:electron": "rimraf release && npm run build -w @writing-tools/shared && npm run build:esbuild && npm run build -w @writing-tools/renderer"
  },
  "dependencies": {
    "@writing-tools/shared": "*",
    "better-sqlite3-multiple-ciphers": "^12.5.0",
    "ollama": "^0.6.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "39.2.7",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "esbuild": "^0.27.2",
    "fs-extra": "^11.3.3",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "typescript": "^4.9.5"
  }
}
