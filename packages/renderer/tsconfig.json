{
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@writing-tools/shared": [
        "../shared/src"
      ],
      "@writing-tools/shared/*": [
        "../shared/src/*"
      ]
    },
    "sourceMap": true
  },
  "extends": "../../tsconfig.json",
  "include": [
    "src"
  ],
  "exclude": [
    "dist"
  ],
  "references": [
    {
      "package": "@writing-tools/shared",
      "path": "../shared"
    }
  ]
}
