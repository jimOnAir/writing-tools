{
  "appId": "com.writingtools.app",
  "asar": false,
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "artifactName": "${productName}-${version}.${ext}",
  "files": [
    {
      "from": "packages/main/dist/electron-app",
      "filter": ["!*.map"],
      "to": "main"
    },
    {
      "from": "packages/main/assets",
      "to": "assets"
    },
    {
      "from": "packages/renderer/build",
      "to": "renderer"
    },
    "package.json"
  ],
  "linux": {
    "category": "Utility",
    "icon": "packages/main/assets/icon.png",
    "target": "AppImage"
  },
  "win": {
    "icon": "packages/main/assets/icon.png",
    "target": "nsis"
  }
}
